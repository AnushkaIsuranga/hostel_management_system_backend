PORT=3000
NODE_ENV=staging

# Database (staging)
# Use your actual Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/unihome_staging

# JWT
JwtSettings__Secret=SET_VIA_ENV
JwtSettings__Issuer=UniHome
JwtSettings__Audience=UniHomeUsers
JwtSettings__UserAccessExpiryMinutes=15
JwtSettings__AdminAccessExpiryMinutes=15

# Auth
AuthSettings__UserRefreshExpiryDays=1
AuthSettings__UserRefreshExpiryRememberDays=30
AuthSettings__AdminRefreshExpiryHours=12
AuthSettings__AdminIdleTimeoutMinutes=30
AuthSettings__RefreshCookieName=refreshToken

# CORS
Cors__AllowedOrigins=https://app-staging.unihome.lk,https://unihome.lk,http://localhost:5173

# Storage (staging default)
STORAGE_DRIVER=cloudinary

# Cloudinary
# Prefer CLOUDINARY_URL in hosted environments.
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>

# Optional AWS fallback (only if you switch STORAGE_DRIVER=s3)
AWS_REGION=us-east-1
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

ImageStorage__CdnBaseUrl=
DataCleanup__RetentionDays=60
DataCleanup__RunIntervalHours=24

AdminCredentials__FullName=System Administrator
AdminCredentials__Email=admin@unihome.lk
AdminCredentials__Password=SET_VIA_ENV
