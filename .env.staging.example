# UniHome Staging Environment Configuration
# For Render deployment
# Copy to .env.staging and update values

PORT=3000
NODE_ENV=staging

# Database - Use Render managed PostgreSQL
# Connection string provided by Render after database creation
DATABASE_URL=postgresql://user:password@host.render.internal:5432/unihome_staging

# JWT Configuration
# Generate a secure random 64-character string for secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JwtSettings__Secret=GENERATE_A_RANDOM_64_CHAR_STRING_HERE
JwtSettings__Issuer=UniHome
JwtSettings__Audience=UniHomeUsers
JwtSettings__UserAccessExpiryMinutes=15
JwtSettings__AdminAccessExpiryMinutes=15

# Auth Settings
AuthSettings__UserRefreshExpiryDays=1
AuthSettings__UserRefreshExpiryRememberDays=30
AuthSettings__AdminRefreshExpiryHours=12
AuthSettings__AdminIdleTimeoutMinutes=30
AuthSettings__RefreshCookieName=refreshToken

# CORS Configuration
# Include staging domain and production domain for testing
Cors__AllowedOrigins=https://staging.unihome.lk,https://unihome.lk,http://localhost:5173

# Storage Configuration - Use AWS S3 for staging
STORAGE_DRIVER=s3

# AWS S3 - Use staging/shared bucket
AWS_REGION=us-east-1
AWS_BUCKET=hostel-staging-storage
AWS_ACCESS_KEY_ID=YOUR_STAGING_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_STAGING_AWS_SECRET_KEY

# CDN Configuration (optional - only if using CloudFront)
ImageStorage__CdnBaseUrl=

# Data Cleanup
DataCleanup__RetentionDays=60
DataCleanup__RunIntervalHours=24

# Admin Credentials - Change in production!
AdminCredentials__FullName=System Administrator
AdminCredentials__Email=admin@unihome.lk
AdminCredentials__Password=CHANGE_THIS_SECURE_PASSWORD
