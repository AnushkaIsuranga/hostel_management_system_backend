# UniHome Production Environment Configuration
# For AWS EC2 deployment with RDS database
# Copy to /home/ubuntu/apps/hostel-api/.env on EC2 and update values

PORT=3000
NODE_ENV=production

# Database - Use AWS RDS
# Format: postgresql://username:password@rds-endpoint:5432/database_name?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_SECURE_PASSWORD@unihome-db.c8luc8scc7as.us-east-1.rds.amazonaws.com:5432/UniHome_Production?sslmode=require

# JWT Configuration
# Generate a secure random 64-character string for secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JwtSettings__Secret=GENERATE_A_RANDOM_64_CHAR_STRING_HERE
JwtSettings__Issuer=UniHome
JwtSettings__Audience=UniHomeUsers
JwtSettings__UserAccessExpiryMinutes=15
JwtSettings__AdminAccessExpiryMinutes=15

# Auth Settings
AuthSettings__UserRefreshExpiryDays=1
AuthSettings__UserRefreshExpiryRememberDays=30
AuthSettings__AdminRefreshExpiryHours=12
AuthSettings__AdminIdleTimeoutMinutes=30
AuthSettings__RefreshCookieName=refreshToken

# CORS Configuration
# Production domains only
Cors__AllowedOrigins=https://unihome.lk,https://api.unihome.lk,https://app.unihome.lk

# Storage Configuration - Use AWS S3 for production
STORAGE_DRIVER=s3

# AWS S3 - Use production bucket
AWS_REGION=us-east-1
AWS_BUCKET=hostel-production-storage
AWS_ACCESS_KEY_ID=YOUR_PRODUCTION_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_PRODUCTION_AWS_SECRET_KEY

# CDN Configuration (optional - if using CloudFront with S3)
ImageStorage__CdnBaseUrl=https://cdn.unihome.lk

# Data Cleanup
DataCleanup__RetentionDays=60
DataCleanup__RunIntervalHours=24

# Admin Credentials - Use secure values!
AdminCredentials__FullName=System Administrator
AdminCredentials__Email=admin@unihome.lk
AdminCredentials__Password=CHANGE_THIS_TO_SECURE_PASSWORD
